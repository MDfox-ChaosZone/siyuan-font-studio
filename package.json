{
  "name": "siyuan-font-studio",
  "version": "0.1.8",
  "description": "Import and configure fonts for SiYuan's interface, editor, code, formulas and diagrams",
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development",
    "dev:setup": "node scripts/setup-dev-link.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "siyuan",
    "font",
    "plugin"
  ],
  "author": "MDfox",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "esbuild-loader": "^4.4.3",
    "mini-css-extract-plugin": "^2.10.2",
    "sass": "^1.93.0",
    "sass-loader": "^16.0.5",
    "siyuan": "^1.2.6",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.0",
    "webpack": "^5.107.0",
    "webpack-cli": "^6.0.1",
    "zip-webpack-plugin": "^4.0.3"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4"
  }
}
